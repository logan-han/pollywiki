---
import Base from '../layouts/Base.astro'
---

<Base title="Search" description="Search people, divisions, bills and electorates across the federal record.">
  <h1>Search the record</h1>
  <p class="note">People, divisions, bills, electorates and parties.</p>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <div id="search" style="margin-top: 1.4rem;"></div>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI !== 'undefined') {
        new PagefindUI({ element: '#search', showSubResults: false, showImages: false })
        const input = document.querySelector('#search input')
        if (input) input.focus()
      } else {
        document.getElementById('search').textContent =
          'Search index not built. Run the full build (pnpm build) to generate it.'
      }
    })
  </script>
</Base>
